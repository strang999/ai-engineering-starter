# Copy to .env (never commit .env). Mock mode needs nothing here.
AIEZ_PROVIDER=mock
AIEZ_MODEL=
# low (default) | medium | high; run_evals --effort overrides it
AIEZ_EFFORT=low
AIEZ_MOCK_SCENARIO=
ANTHROPIC_API_KEY=
# only if your Anthropic key is not scoped to a workspace:
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
